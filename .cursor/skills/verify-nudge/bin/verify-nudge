    add("event-cooldown-expired", config(), herdr(PANE_HERDR), state({"auto": True, "panes": {"p_1": {"last_auto_at": {"ago": 360000}}}}), event("blocked"))
    add("event-self-notified", config(), herdr(PANE_HERDR),
        state({"auto": True, "panes": {"p_1": {"working_since": {"ago": 180000}, "self_notified_at": {"ago": 10000}}}}), event("done"))
    add("event-self-notified-blocked-no-turn", config(), herdr(PANE_HERDR),
        state({"auto": True, "panes": {"p_1": {"self_notified_at": {"ago": 60000}}}}), event("blocked"))
    add("event-notify-then-event", config(), herdr(PANE_HERDR), state({"auto": True}), event("working"),
        cmd(["notify", "I am done"], env={"HERDR_PANE_ID": "p_1"}, expect=0),
        {"do": "edit_state", "pane": "p_1", "key": "working_since", "ago": 300000}, event("done"))
    add("event-idle-unknown", config(), herdr(PANE_HERDR), state({"auto": True, "panes": {"p_1": {"working_since": {"ago": 300000}}}}),
