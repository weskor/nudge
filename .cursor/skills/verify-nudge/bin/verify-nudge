# herdr workspaces, with herdr's real JSON shapes (`agent get`, `pane get`, `workspace get` as herdr 0.9 prints them).
# Workspace wD "api-work": pane wD:p1 agent claude-1, pane wD:p3 a plain shell. Workspace wE "web-work": pane
# wE:p2 agent reviewer.
WORKSPACES = {"wD": ("api-work", 1), "wE": ("web-work", 2)}


def real_agent_get(pane, name, cwd="{RUN}/repo", focused=False):
    ws = pane.split(":")[0]
    return rule(["agent", "get", pane], {"id": "cli:agent:get", "result": {"agent": {
        "name": name, "pane_id": pane, "workspace_id": ws, "tab_id": f"{ws}:t1", "focused": focused,
        "cwd": cwd, "foreground_cwd": cwd, "agent_status": "working"}}, "type": "agent_info"})


def pane_get(pane, agent="omp", focused=False):
    ws = pane.split(":")[0]
    return rule(["pane", "get", pane], {"id": "cli:pane:get", "result": {"pane": {
        "pane_id": pane, "workspace_id": ws, "tab_id": f"{ws}:t1", "agent": agent,
        "agent_status": "working" if agent else "idle", "focused": focused, "cwd": "{RUN}/repo"}}})


def workspace_get(ws):
    label, number = WORKSPACES[ws]
    return rule(["workspace", "get", ws], {"id": "cli:workspace:get", "result": {"type": "workspace_info", "workspace": {
        "workspace_id": ws, "label": label, "number": number, "focused": ws == "wD"}}})


def workspaces_fixture(agent_list=True):
    """Two workspaces; with `agent_list`, `agent list` puts claude-1 (wD:p1) on <RUN>/work for cwd matching."""
    agents = [{"name": "claude-1", "pane_id": "wD:p1", "workspace_id": "wD", "cwd": "{RUN}/work"},
              {"name": "reviewer", "pane_id": "wE:p2", "workspace_id": "wE", "cwd": "/elsewhere"}]
    return fixture(
        HERDR_VERSION, plugin_list(plugin()), PLUGIN_LOGS, NOTIFICATION_OK, PANE_OPEN_OK,
        real_agent_get("wD:p1", "claude-1"), real_agent_get("wE:p2", "reviewer"), rule(["agent", "get", "wD:p3"], "", exit=1),
        pane_get("wD:p1"), pane_get("wE:p2"), pane_get("wD:p3", agent=None),
        workspace_get("wD"), workspace_get("wE"),
        pane_read("wD:p1", PANE_TEXT), pane_read("wE:p2", PANE_TEXT),
        rule(["agent", "list"], {"result": {"agents": agents if agent_list else []}}),
    )


PRESETS = {
    "none": None,
    "running": fixture(HERDR_VERSION, plugin_list(plugin()), PLUGIN_LOGS, NO_AGENTS, NOTIFICATION_OK, PANE_OPEN_OK),
    "agent-pane": fixture(
        HERDR_VERSION, plugin_list(plugin()), PLUGIN_LOGS, NOTIFICATION_OK, PANE_OPEN_OK,
        agent_get("p_1", "claude-1"), pane_read("p_1", PANE_TEXT),
        rule(["agent", "list"], {"result": {"agents": [{"name": "claude-1", "pane_id": "p_1", "cwd": "{RUN}/repo"}]}}),
    ),
    "workspaces": workspaces_fixture(),
}


def desks_config(port, offline_port, default="desk", extra=""):
    """The standard desks; `extra` (e.g. an [auto] or [scope] table) is appended verbatim."""
    hook = f"http://127.0.0.1:{port}"
    desks = [
        ("desk", "Main desk", f"{hook}/hook", GOOD, None),
        ("research", "Research desk", f"{hook}/hook", GOOD, None),
        ("badauth", None, f"{hook}/hook", WRONG, None),
        ("nohook", None, f"{hook}/nope", GOOD, None),
        ("broken", None, f"{hook}/fail", GOOD, None),
        ("offline", None, f"http://127.0.0.1:{offline_port}/hook", GOOD, None),
        ("signed", "Signed desk", f"{hook}/signed", GOOD, SIGNING_SECRET),
    ]
    lines = [f'default_desk = "{default}"', ""] if default else []
    for name, description, url, auth, secret in desks:
        lines += ["[[desk]]", f'name = "{name}"']
        if description:
            lines.append(f'description = "{description}"')
        lines += [f'url = "{url}"', f'authorization = "{auth}"']
        if secret:
            lines.append(f'signing_secret = "{secret}"')
        lines.append("")
    return "\n".join(lines) + extra


# --------------------------------------------------------------------------------------------- sandbox


class Sandbox:
    """One isolated HOME/config/state/fakes directory (<RUN>). Nothing in it points at the user's real files."""

    def __init__(self, run, binary, port, offline_port, requests_file):
        self.run = run
        self.binary = binary
        self.port = port
        self.offline_port = offline_port
        self.requests_file = requests_file
        self.home = os.path.join(run, "home")
        self.config = os.path.join(self.home, ".config", "nudge", "config.toml")
        self.state_dir = os.path.join(self.home, ".local", "state", "nudge")
        self.link = os.path.join(self.home, ".local", "bin", "nudge")
        self.seeded = {}
        self.marks = {}

    def create(self):
        for d in ("home", "work", "fakebin", "plugin"):
            os.makedirs(os.path.join(self.run, d), exist_ok=True)
        os.makedirs(os.path.join(self.run, "runtime"), mode=0o700, exist_ok=True)
        # sh wrappers run the fakes with this interpreter, so the sandbox PATH needs no python3 of its own.
        # VERIFY_NUDGE_FAKE tells the fake which <RUN>/fakebin entry was invoked.
        for name, target in (("herdr", "fake-herdr"), ("wl-paste", "fake-clipboard"), ("xclip", "fake-clipboard")):
            path = os.path.join(self.run, "fakebin", name)
            if not os.path.lexists(path):
                with open(path, "w") as f:
                    f.write(f'#!/bin/sh\nVERIFY_NUDGE_FAKE="$0" exec {shlex.quote(sys.executable)} '
                            f'{shlex.quote(os.path.join(BIN_DIR, target))} "$@"\n')
                os.chmod(path, 0o755)
        return self

    def env(self, extra=None, tty=False):
        env = {
            "PATH": f"{self.run}/fakebin:/usr/local/bin:/usr/bin:/bin",
            "HOME": self.home,
            "XDG_CONFIG_HOME": os.path.join(self.home, ".config"),
            "XDG_STATE_HOME": os.path.join(self.home, ".local", "state"),
            "XDG_RUNTIME_DIR": os.path.join(self.run, "runtime"),
            "NUDGE_CONFIG": self.config,
            "NUDGE_STATE_DIR": self.state_dir,
            "HERDR_BIN_PATH": os.path.join(self.run, "fakebin", "herdr"),
            "LANG": "C.UTF-8",
            "LC_ALL": "C.UTF-8",
            "GIT_CONFIG_NOSYSTEM": "1",
        }
        if tty:
            env["TERM"] = "xterm-256color"
        for key, value in (extra or {}).items():
            if value is None:
                env.pop(key, None)
            else:
                env[key] = value.replace("{RUN}", self.run)
        return env

    def cwd(self, where):
        return where if os.path.isabs(where or "") else os.path.join(self.run, where or "work")

    # ---- seeding

    def write_config(self, text, mode=0o600):
        os.makedirs(os.path.dirname(self.config), mode=0o700, exist_ok=True)
        with open(self.config, "w") as f:
            f.write(text)
        os.chmod(self.config, mode)

    def write_state(self, state):
        def resolve(value):
            if isinstance(value, dict) and list(value) == ["ago"]:
                stamp = now_ms() - value["ago"]
                self.seeded[stamp] = f"<now-{value['ago']}ms>"
                return stamp
            if isinstance(value, dict):
                return {k: resolve(v) for k, v in value.items()}
            return value
        os.makedirs(self.state_dir, mode=0o700, exist_ok=True)
        path = os.path.join(self.state_dir, "state.json")
        with open(path, "w") as f:
            json.dump(resolve(state), f)
        os.chmod(path, 0o600)

    def edit_state(self, pane, key, ago):
        path = os.path.join(self.state_dir, "state.json")
        state = json.load(open(path))
        stamp = now_ms() - ago
        self.seeded[stamp] = f"<now-{ago}ms>"
        state.setdefault("panes", {}).setdefault(pane, {})[key] = stamp
        with open(path, "w") as f:
            json.dump(state, f)

    def write_herdr(self, fix):
        path = os.path.join(self.run, "herdr.json")
        if fix is None:
            if os.path.exists(path):
                os.remove(path)
            return
        with open(path, "w") as f:
            json.dump(fix, f, indent=1)

    def clip(self, text):
        with open(os.path.join(self.run, "clipboard.txt"), "w") as f:
            f.write(text or "")

    def git_repo(self, name, branch, origin=None):
        path = os.path.join(self.run, name)
        os.makedirs(path, exist_ok=True)
        env = self.env()
        git = lambda *a: subprocess.run(["git", *a], cwd=path, env=env, check=True, capture_output=True)
        git("init", "-q", "-b", branch)
        if origin:
            git("remote", "add", "origin", origin)
        git("-c", "user.name=verify", "-c", "user.email=verify@example.invalid", "commit", "-q", "--allow-empty", "-m", "init")

    # ---- observation

    def _since(self, path, key):
        try:
            with open(path, "rb") as f:
                f.seek(self.marks.get(key, 0))
                data = f.read()
                self.marks[key] = f.tell()
        except FileNotFoundError:
            return []
        return [json.loads(line) for line in data.decode().splitlines() if line.strip()]

    def mark(self):
        for key, path in self._logs():
            self._since(path, key)

    def _logs(self):
        return (("requests", self.requests_file), ("herdr", os.path.join(self.run, "herdr-calls.jsonl")),
                ("clipboard", os.path.join(self.run, "clipboard-calls.jsonl")))

    def side_effects(self):
        requests, herdr, clipboard = (self._since(path, key) for key, path in self._logs())
        # herdr calls can run concurrently (agent get + pane read), so their order is not behavior.
        herdr = sorted((c["argv"] for c in herdr), key=lambda a: json.dumps(a))
        return {"webhook": requests, "herdr_calls": herdr, "clipboard_calls": clipboard}

    def files(self):
        def mode(path):
            return format(os.stat(path).st_mode & 0o777, "03o")

        def entries(d):
            return sorted(os.listdir(d)) if os.path.isdir(d) else None

        out = {}
        if os.path.exists(self.config):
            out["config"] = {"mode": mode(self.config), "dir_mode": mode(os.path.dirname(self.config)), "text": open(self.config).read()}
        else:
            out["config"] = None
        out["config_dir_entries"] = entries(os.path.dirname(self.config))
        state_path = os.path.join(self.state_dir, "state.json")
        if os.path.exists(state_path):
            text = open(state_path).read()
            try:
                state = json.loads(text)
            except ValueError:
                state = {"unparseable": text}
            out["state"] = {"mode": mode(state_path), "dir_mode": mode(self.state_dir), "json": state}
        else:
            out["state"] = None
        out["state_dir_entries"] = entries(self.state_dir)
        if os.path.islink(self.link):
            out["command_link"] = {"type": "symlink", "target": os.readlink(self.link)}
        elif os.path.exists(self.link):
            out["command_link"] = {"type": "file"}
        else:
            out["command_link"] = None
        return out

    # ---- drivers

    def run_cmd(self, args, stdin=None, env=None, cwd=None, timeout=60):
        self.mark()
        try:
            proc = subprocess.run(
                [self.binary, *args], input=(stdin or "").encode() if stdin is not None else None,
                stdin=subprocess.DEVNULL if stdin is None else None, capture_output=True,
                env=self.env(env), cwd=self.cwd(cwd), timeout=timeout,
            )
            code, out, err = proc.returncode, proc.stdout.decode(errors="replace"), proc.stderr.decode(errors="replace")
        except subprocess.TimeoutExpired as e:
            code, out, err = "timeout", (e.stdout or b"").decode(errors="replace"), (e.stderr or b"").decode(errors="replace")
        record = {"kind": "cmd", "argv": args, "stdin": stdin, "env": env or {}, "cwd": cwd or "work",
                  "exit": code, "stdout": out, "stderr": err}
        record.update(self.side_effects())
        record["files"] = self.files()
        return record

    def run_pty(self, args, script, env=None, cwd=None, timeout=15):
        import fcntl
        import termios
        self.mark()
        master, slave = os.openpty()
        fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 40, 120, 0, 0))

        def controlling_tty():
            os.setsid()
            fcntl.ioctl(0, termios.TIOCSCTTY, 0)

        proc = subprocess.Popen([self.binary, *args], stdin=slave, stdout=slave, stderr=slave,
                                env=self.env(env, tty=True), cwd=self.cwd(cwd), preexec_fn=controlling_tty)
        os.close(slave)
        buf = bytearray()
        eof = False

        def pump(wait):
            nonlocal eof
            if eof:
                return
            ready, _, _ = select.select([master], [], [], wait)
            if ready:
                try:
                    data = os.read(master, 65536)
                except OSError:
                    data = b""
                if data:
                    buf.extend(data)
                else:
                    eof = True

        pos = 0
        failures = []
        for op, arg in script:
            if op == "expect":
                pattern = re.compile(arg)
                deadline = time.time() + timeout
                while True:
                    text = buf.decode(errors="replace")
                    match = pattern.search(text, pos)
                    if match:
                        pos = match.end()
                        break
                    if eof or time.time() > deadline:
                        failures.append(f"expect {arg!r} not seen")
                        break
                    pump(0.05)
            elif op == "send":
                time.sleep(0.2)  # let the prompt switch the terminal to raw mode first
                try:
                    os.write(master, unescape(arg).encode())
                except OSError:
                    failures.append(f"send {arg!r}: terminal already closed")
            elif op == "clip":
                self.clip(arg)
        deadline = time.time() + timeout
        while not eof and time.time() < deadline:
            pump(0.05)
        try:
            code = proc.wait(timeout=max(0.1, deadline - time.time()))
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
            code = "timeout"
        os.close(master)
        record = {"kind": "pty", "argv": args, "script": [list(s) for s in script], "env": env or {}, "exit": code,
                  "output": buf.decode(errors="replace"), "expect_failures": failures}
        record.update(self.side_effects())
        record["files"] = self.files()
        return record

    def run_mcp(self, messages, env=None, timeout=20):
        """Send JSON-RPC messages over stdio; wait for each request's response; then close stdin."""
        self.mark()
        proc = subprocess.Popen([self.binary, "mcp"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                env=self.env(env), cwd=self.cwd(None))
        lines, err, eof = [], [], []
        cond = threading.Condition()

        def read_out():
            for line in proc.stdout:
                with cond:
                    lines.append(line.decode(errors="replace"))
                    cond.notify_all()
            with cond:
                eof.append(True)
                cond.notify_all()

        reader = threading.Thread(target=read_out, daemon=True)
        reader.start()
        err_thread = threading.Thread(target=lambda: err.append(proc.stderr.read().decode(errors="replace")), daemon=True)
        err_thread.start()

        def has_response(msg_id):
            for line in lines:
                try:
                    if json.loads(line).get("id") == msg_id:
                        return True
                except ValueError:
                    pass
            return False

        missing = []
        for message in messages:
            try:
                proc.stdin.write((json.dumps(message) + "\n").encode())
                proc.stdin.flush()
            except BrokenPipeError:
                pass  # the server already exited; the missing responses below record it
            if "id" in message:
                with cond:
                    cond.wait_for(lambda: has_response(message["id"]) or eof, timeout)
                    if not has_response(message["id"]):
                        missing.append(message["id"])
        try:
            proc.stdin.close()
        except BrokenPipeError:
            pass
        try:
            code = proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
            code = "still running 10s after stdin closed (killed)"
        reader.join(5)
        err_thread.join(5)
        responses, other = {}, []
        for line in lines:
            try:
                msg = json.loads(line)
            except ValueError:
                other.append(line)
                continue
            if isinstance(msg, dict) and "id" in msg and ("result" in msg or "error" in msg):
                responses[str(msg["id"])] = msg
            else:
                other.append(msg)
        record = {"kind": "mcp", "argv": ["mcp"], "requests": messages, "env": env or {}, "exit": code,
                  "responses_by_id": responses, "other_stdout": other, "missing_responses": missing, "stderr": "".join(err)}
        record.update(self.side_effects())
        record["files"] = self.files()
        return record


# --------------------------------------------------------------------------------------------- normalization


class Normalizer:
    def __init__(self, sandbox, root, t0):
        self.sb = sandbox
        self.t0 = t0
        pairs = [(sandbox.run, "<RUN>"), (os.path.realpath(sandbox.run), "<RUN>")]
        if len(root) > 1:
            pairs.append((root, "<NUDGE_ROOT>"))
        pairs += [(f"127.0.0.1:{sandbox.port}", "127.0.0.1:<PORT>"), (f"127.0.0.1:{sandbox.offline_port}", "127.0.0.1:<OFFLINE_PORT>")]
        self.pairs = sorted(set(pairs), key=lambda p: -len(p[0]))

    def text(self, s):
        for old, new in self.pairs:
            s = s.replace(old, new)
        # Per-notification id and sent_at; only well-formed values, so a malformed one stays visible in the diff.
        s = UUID_V4_TEXT.sub("<uuid>", s)
        return SENT_AT_TEXT.sub("<sent_at>", s)

    @staticmethod
    def webhook_request(req):
        """Drop the receive time; replace a fresh x-nudge-timestamp and a well-formed signature (its validity is
        the recorded "signature" verdict) with placeholders. Anything off stays raw so the diff shows it."""
        req = dict(req)
        received = req.pop("received_unix", None)
        headers = dict(req.get("headers") or {})
        if timestamp_fresh(headers.get("x-nudge-timestamp"), received):
            headers["x-nudge-timestamp"] = "<ts>"
        if SIGNATURE.fullmatch(headers.get("x-nudge-signature") or ""):
            headers["x-nudge-signature"] = "sha256=<hmac>"
        req["headers"] = headers
        return req

    def epoch(self, value, t1):
        if value in self.sb.seeded:
            return self.sb.seeded[value]
        if self.t0 - 5 <= value <= t1 + 5:
            return "<now>"
        return "<epoch-ms>"

    def value(self, obj, t1, epochs=False):
        if isinstance(obj, str):
            return self.text(obj)
        if isinstance(obj, bool) or obj is None:
            return obj
        if isinstance(obj, int) and epochs and obj > 10**12:
            return self.epoch(obj, t1)
        if isinstance(obj, list):
            return [self.value(v, t1, epochs) for v in obj]
        if isinstance(obj, dict):
            return {self.text(k): self.value(v, t1, epochs) for k, v in obj.items()}
        return obj

    def record(self, rec, t1):
        rec = dict(rec)
        files = rec.pop("files", None)
        if "webhook" in rec:
            rec["webhook"] = [self.webhook_request(r) for r in rec["webhook"]]
        rec = self.value(rec, t1)
        # JSON text inside MCP tool results is compared as data too.
        for response in rec.get("responses_by_id", {}).values():
            for item in (response.get("result") or {}).get("content") or []:
                try:
                    item["text_json"] = json.loads(item["text"])
                    del item["text"]
                except (KeyError, TypeError, ValueError):
                    pass
        # doctor's "Recent:" lines end with a relative age ("just now", "5m ago", "371d ago"); it changes daily.
        for key in ("stdout", "output"):
            if isinstance(rec.get(key), str):
                rec[key] = RECENT_AGE.sub(r"\1<ago>\3", rec[key])
        # JSON stdout (list --json) is compared as data, not bytes.
        if rec.get("stdout"):
            try:
                rec["stdout_json"] = json.loads(rec["stdout"])
                del rec["stdout"]
            except ValueError:
                pass
        for key in ("stdout", "stderr", "output", "stdin"):
            if isinstance(rec.get(key), str) and "\n" in rec[key]:
                rec[key] = rec[key].split("\n")
        if files is not None:
            files = self.value(files, t1, epochs=False)
            if files.get("state"):
                files["state"]["json"] = self.value(files["state"]["json"], t1, epochs=True)
            if files.get("config"):
                files["config"]["text"] = files["config"]["text"].split("\n")
            rec["files"] = files
        return rec


def secret_leaks(rec):
    """Desk secrets (Authorization tokens, signing secrets) found in anything nudge showed or sent outside the
    Authorization header: output, MCP responses, webhook bodies, herdr toasts."""
    texts = [rec.get(k) for k in ("stdout", "stderr", "output")]
    texts += [json.dumps(r, ensure_ascii=False) for r in rec.get("responses_by_id", {}).values()]
    texts += [json.dumps(r.get("body"), ensure_ascii=False) for r in rec.get("webhook", [])]
    texts += [json.dumps(c, ensure_ascii=False) for c in rec.get("herdr_calls", [])]
    return [m for m in SECRET_MARKERS for t in texts if isinstance(t, str) and m in t]


def timestamp_fresh(value, received, window=60):
    """x-nudge-timestamp is unix seconds within `window` s of when the fake desk received the request."""
    return isinstance(value, str) and value.isdigit() and received is not None and abs(int(value) - received) <= window


def sent_at_unix(value):
    if not (isinstance(value, str) and SENT_AT.fullmatch(value)):
        return None
    return calendar.timegm(time.strptime(value, "%Y-%m-%dT%H:%M:%SZ"))


def contract_checks(rec):
    """Problems with what the desk received (signature, timestamp, id, sent_at) and with MCP notify results,
    checked on the raw record before normalization hides the values."""
    problems = []
    bodies = []
    for req in rec.get("webhook", []):
        path, headers, body, received = req.get("path"), req.get("headers") or {}, req.get("body"), req.get("received_unix")
        verdict = req.get("signature")
        if verdict is not None and not verdict.startswith("valid:"):
            problems.append(f"{path} request signature {verdict}")
        signing = [h for h in ("x-nudge-timestamp", "x-nudge-signature") if h in headers]
        if path != "/signed" and signing:
            problems.append(f"{path} (desk without signing_secret) got {', '.join(signing)}")
        if "x-nudge-timestamp" in headers and not timestamp_fresh(headers["x-nudge-timestamp"], received):
            problems.append(f"{path} x-nudge-timestamp {headers['x-nudge-timestamp']!r} is not unix seconds within 60 s of the request")
        if not isinstance(body, dict):
            continue
        bodies.append(body)
        if not (isinstance(body.get("id"), str) and UUID_V4.fullmatch(body["id"])):
            problems.append(f"{path} body id {body.get('id', '<missing>')!r} is not a lowercase UUID v4")
        stamp = sent_at_unix(body.get("sent_at"))
        if stamp is None:
            problems.append(f"{path} body sent_at {body.get('sent_at', '<missing>')!r} is not YYYY-MM-DDTHH:MM:SSZ")
        elif received is not None and abs(stamp - received) > 60:
            problems.append(f"{path} body sent_at {body['sent_at']!r} is not within 60 s of the request")
    for msg_id, response in sorted(rec.get("responses_by_id", {}).items()):
        for item in (response.get("result") or {}).get("content") or []:
            try:
                result = json.loads(item["text"])
            except (KeyError, TypeError, ValueError):
                continue
            if not (isinstance(result, dict) and result.get("ok") is True):
                continue
            sent = [b for b in bodies if b.get("id") == result.get("id")]
            if not (isinstance(result.get("id"), str) and UUID_V4.fullmatch(result["id"])):
                problems.append(f"MCP response {msg_id}: id {result.get('id', '<missing>')!r} is not a lowercase UUID v4")
            elif not sent:
                problems.append(f"MCP response {msg_id}: id is not the id of a request the desk received")
            if sent_at_unix(result.get("sent_at")) is None:
                problems.append(f"MCP response {msg_id}: sent_at {result.get('sent_at', '<missing>')!r} is not YYYY-MM-DDTHH:MM:SSZ")
            elif sent and sent[0].get("sent_at") != result["sent_at"]:
                problems.append(f"MCP response {msg_id}: sent_at differs from the request the desk received")
    return problems


# --------------------------------------------------------------------------------------------- session


def session_id():
    sid = os.environ.get("VERIFY_NUDGE_SESSION")
    if not sid:
        try:
            sid = open(os.path.join(EVIDENCE_ROOT, "current")).read().strip()
        except FileNotFoundError:
            die("no session: run `verify-nudge launch` first")
    return sid


def load_session():
    sid = session_id()
    path = os.path.join(EVIDENCE_ROOT, sid, "session.json")
    if not os.path.exists(path):
        die(f"session {sid} not found at {path}")
    return json.load(open(path))


def save_session(s):
    with open(os.path.join(s["evidence"], "session.json"), "w") as f:
        json.dump(s, f, indent=2)


def session_sandbox(s):
    sb = Sandbox(s["run"], s["nudge_bin"], s["port"], s["offline_port"], os.path.join(s["scratch"], "requests.jsonl"))
    sb.seeded = {int(k): v for k, v in s.get("seeded", {}).items()}
    marks_path = os.path.join(s["scratch"], "marks.json")
    if os.path.exists(marks_path):
        sb.marks = json.load(open(marks_path))
    return sb


def persist_marks(s, sb):
    with open(os.path.join(s["scratch"], "marks.json"), "w") as f:
        json.dump(sb.marks, f)
    s["seeded"] = {str(k): v for k, v in sb.seeded.items()}
    save_session(s)


def cmd_launch(argv):
    binary = nudge_bin()
    sid = time.strftime("%Y%m%d-%H%M%S") + "-" + os.urandom(2).hex()
    evidence = os.path.join(EVIDENCE_ROOT, sid)
    os.makedirs(evidence)
    scratch = os.path.realpath(tempfile.mkdtemp(prefix=f"verify-nudge-{sid}-"))
    pid, port = start_webhook(scratch, sid)
    s = {"id": sid, "scratch": scratch, "run": os.path.join(scratch, "run"), "evidence": evidence,
         "nudge_bin": binary, "nudge_root": nudge_root(binary), "pid": pid, "port": port, "offline_port": free_port(),
         "created": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "cleaned": False, "steps": 0}
    session_sandbox(s).create()
    save_session(s)
    with open(os.path.join(EVIDENCE_ROOT, "current"), "w") as f:
        f.write(sid)
    print(f"verify-nudge: ready session={sid}")
    print(f"  nudge:    {binary}")
    print(f"  webhook:  http://127.0.0.1:{port}/hook  (good Authorization: {GOOD!r}; /fail = 500; other paths = 404)")
    print(f"  signed:   http://127.0.0.1:{port}/signed  (also needs x-nudge-signature with signing secret {SIGNING_SECRET!r})")
    print(f"  offline:  http://127.0.0.1:{s['offline_port']}/hook  (nothing listens)")
    print(f"  sandbox:  {s['run']}  (HOME, config, state, fake herdr/wl-paste/xclip)")
    print(f"  evidence: {evidence}")
    print(f"  export VERIFY_NUDGE_SESSION={sid}  # to pin this session in another shell")


def cmd_doctor(argv):
    s = load_session()
    sb = session_sandbox(s)
    problems = []

    def check(ok, title, detail=""):
        print(f"{'ok  ' if ok else 'FAIL'} {title}{'  ' + detail if detail else ''}")
        if not ok:
            problems.append(title)

    check(not s["cleaned"], f"session {s['id']} not cleaned up")
    check(os.path.isdir(s["run"]), "sandbox exists", s["run"])
    alive = pid_is(s["pid"], "fake-webhook")
    check(alive, "fake webhook process is ours and alive", f"pid {s['pid']}")
    check(webhook_owner(s["port"]) == s["id"], "webhook port answers with this session id", f"127.0.0.1:{s['port']}")
    check(os.access(s["nudge_bin"], os.X_OK), "NUDGE_BIN executable", s["nudge_bin"])
    env = sb.env()
    for tool in ("herdr", "wl-paste", "xclip"):
        found = shutil.which(tool, path=env["PATH"])
        check(found == os.path.join(s["run"], "fakebin", tool), f"{tool} resolves to the fake", found or "not found")
    real_home = os.path.expanduser("~")
    isolated = all(env[k].startswith(s["run"]) for k in ("HOME", "NUDGE_CONFIG", "NUDGE_STATE_DIR", "XDG_CONFIG_HOME", "XDG_STATE_HOME", "XDG_RUNTIME_DIR", "HERDR_BIN_PATH"))
    check(isolated and not env["HOME"].startswith(real_home + "/.config"), "config/state/HOME isolated in the sandbox")
    check(not any(k in env for k in ("DISPLAY", "WAYLAND_DISPLAY", "HERDR_PANE_ID", "HERDR_WORKSPACE_ID", "NUDGE_AGENT")),
          "no display, pane, workspace or agent variables leak in")
    try:
        out = subprocess.run([s["nudge_bin"], "version"], capture_output=True, text=True, env=env, cwd=sb.cwd(None), timeout=60)
        check(out.returncode == 0 and out.stdout.strip() != "", "nudge version runs", out.stdout.strip() or out.stderr.strip())
    except (OSError, subprocess.SubprocessError) as e:
        check(False, "nudge version runs", str(e))
    rev = subprocess.run(["git", "-C", REPO, "rev-parse", "--short", "HEAD"], capture_output=True, text=True).stdout.strip()
    dirty = subprocess.run(["git", "-C", REPO, "status", "--porcelain"], capture_output=True, text=True).stdout.strip() != ""
    print(f"info checkout {REPO} at {rev}{' (dirty)' if dirty else ''}; nudge root {s['nudge_root']}")
    sys.exit(1 if problems else 0)


def parse_common(argv, allowed):
    """Parse leading options up to `--`; returns (opts, ordered steps, rest)."""
    if "--" not in argv:
        rest, head = [], argv
    else:
        i = argv.index("--")
        head, rest = argv[:i], argv[i + 1:]
    opts = {"env": {}, "steps": [], "calls": []}
    it = iter(head)
    for flag in it:
        if flag not in allowed:
            die(f"unknown option {flag}", 2)
        if flag == "--env":
            key, _, value = next(it).partition("=")
            opts["env"][key] = value
        elif flag in ("--expect", "--send", "--clip") and allowed.get(flag) == "step":
            opts["steps"].append([flag[2:], next(it)])
        elif flag == "--call":
            opts["calls"].append((next(it), json.loads(next(it))))
        else:
            opts[flag[2:]] = next(it)
    return opts, rest


def report(s, sb, rec, t0, label):
    norm = Normalizer(sb, s["nudge_root"], t0).record(rec, now_ms())
    leaks = secret_leaks(rec)
    problems = contract_checks(rec)
    s["steps"] += 1
    path = os.path.join(s["evidence"], f"{s['steps']:03d}-{label}.json")
    norm["secret_leaks"] = leaks
    norm["contract_problems"] = problems
    with open(path, "w") as f:
        json.dump(norm, f, indent=2, ensure_ascii=False, sort_keys=True)
    persist_marks(s, sb)
    print(json.dumps(norm, indent=2, ensure_ascii=False, sort_keys=True))
    print(f"evidence: {path}")
    if leaks:
        print(f"WARNING: secret printed: {leaks}")
    for problem in problems:
        print(f"WARNING: {problem}")
    return norm


def slug(args):
    return re.sub(r"[^A-Za-z0-9]+", "-", "-".join(args[:2]) or "noargs").strip("-")[:40]


def cmd_run(argv):
    s = load_session()
    sb = session_sandbox(s)
    opts, rest = parse_common(argv, {"--stdin": 1, "--stdin-file": 1, "--env": 1, "--cwd": 1, "--expect": 1})
    stdin = opts.get("stdin")
    if "stdin-file" in opts:
        stdin = open(opts["stdin-file"]).read()
    if stdin is not None:
        stdin = unescape(stdin)
    t0 = now_ms()
    rec = sb.run_cmd(rest, stdin=stdin, env=opts["env"], cwd=opts.get("cwd"))
    report(s, sb, rec, t0, "run-" + slug(rest))
    if "expect" in opts and str(rec["exit"]) != opts["expect"]:
        die(f"exit {rec['exit']}, expected {opts['expect']}")


def cmd_pty(argv):
    s = load_session()
    sb = session_sandbox(s)
    opts, rest = parse_common(argv, {"--env": 1, "--cwd": 1, "--expect-exit": 1, "--expect": "step", "--send": "step", "--clip": "step"})
    t0 = now_ms()
    rec = sb.run_pty(rest, opts["steps"], env=opts["env"], cwd=opts.get("cwd"))
    report(s, sb, rec, t0, "pty-" + slug(rest))
    if rec["expect_failures"]:
        die(f"expectations failed: {rec['expect_failures']}")
    if "expect-exit" in opts and str(rec["exit"]) != opts["expect-exit"]:
        die(f"exit {rec['exit']}, expected {opts['expect-exit']}")


def mcp_messages(calls):
    msgs = [
        {"jsonrpc": "2.0", "id": 1, "method": "initialize",
         "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "verify-nudge", "version": "1"}}},
        {"jsonrpc": "2.0", "method": "notifications/initialized"},
        {"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}},
    ]
    for i, (name, args) in enumerate(calls, start=3):
        msgs.append({"jsonrpc": "2.0", "id": i, "method": "tools/call", "params": {"name": name, "arguments": args}})
    return msgs


def cmd_mcp(argv):
    s = load_session()
    sb = session_sandbox(s)
    opts, _ = parse_common(argv, {"--env": 1, "--call": 1})
    t0 = now_ms()
    rec = sb.run_mcp(mcp_messages(opts["calls"]), env=opts["env"])
    report(s, sb, rec, t0, "mcp")


def cmd_seed_config(argv):
    s = load_session()
    sb = session_sandbox(s)
    usage = "usage: verify-nudge seed-config [--default NAME] [--append TOML]"
    opts = {"default": "desk", "append": ""}
    it = iter(argv)
    for flag in it:
        if flag not in ("--default", "--append"):
            die(usage, 2)
        value = next(it, None)
        if value is None:
            die(usage, 2)
        opts[flag[2:]] = value
    extra = "\n" + unescape(opts["append"]) if opts["append"] else ""
    sb.write_config(desks_config(s["port"], s["offline_port"], opts["default"], extra))
    print(f"wrote {sb.config}: default {opts['default']!r}; desks desk + research (accept), badauth (401), nohook (404), "
          f"broken (500), offline (refused), signed (accepts with a valid signature)" + (" + appended TOML" if extra else ""))


def cmd_git_repo(argv):
    s = load_session()
    sb = session_sandbox(s)
    if len(argv) not in (2, 3):
        die("usage: verify-nudge git-repo NAME BRANCH [ORIGIN]", 2)
    sb.git_repo(argv[0], argv[1], argv[2] if len(argv) == 3 else None)
    print(f"git repo {os.path.join(sb.run, argv[0])} on {argv[1]}" + (f", origin {argv[2]}" if len(argv) == 3 else ", no origin"))


def cmd_link(argv):
    s = load_session()
    sb = session_sandbox(s)
    if len(argv) != 1:
        die("usage: verify-nudge link TARGET | --file | --remove", 2)
    if os.path.lexists(sb.link):
        os.remove(sb.link)
    os.makedirs(os.path.dirname(sb.link), exist_ok=True)
    if argv[0] == "--file":
        with open(sb.link, "w") as f:
            f.write("#!/bin/sh\n")
    elif argv[0] != "--remove":
        os.symlink(argv[0].replace("{NUDGE_ROOT}", s["nudge_root"]), sb.link)
    print(f"{sb.link}: {argv[0]}")


def cmd_seed_state(argv):
    s = load_session()
    sb = session_sandbox(s)
    if len(argv) != 1:
        die('usage: verify-nudge seed-state \'{"auto": true, "panes": {"p_1": {"working_since": {"ago": 180000}}}}\'', 2)
    sb.write_state(json.loads(argv[0]))
    persist_marks(s, sb)
    print(open(os.path.join(sb.state_dir, "state.json")).read())


def cmd_herdr(argv):
    s = load_session()
    sb = session_sandbox(s)
    if len(argv) != 1:
        die(f"usage: verify-nudge herdr {'|'.join(PRESETS)}|FILE.json", 2)
    fix = PRESETS[argv[0]] if argv[0] in PRESETS else json.load(open(argv[0]))
    sb.write_herdr(fix)
    print(f"fake herdr fixture: {argv[0]}" + ("" if fix else " (herdr acts as not installed)"))


def cmd_clip(argv):
    s = load_session()
    sb = session_sandbox(s)
    if argv == ["--clear"]:
        sb.clip("")
        print("clipboard cleared")
    elif len(argv) == 1:
        sb.clip(argv[0])
        print("clipboard set")
    else:
        die("usage: verify-nudge clip TEXT | --clear", 2)


def cmd_files(argv):
    s = load_session()
    sb = session_sandbox(s)
    print(json.dumps(Normalizer(sb, s["nudge_root"], 0).record({"files": sb.files()}, now_ms()), indent=2, sort_keys=True))


def cmd_requests(argv):
    s = load_session()
    path = os.path.join(s["scratch"], "requests.jsonl")
    print(open(path).read() if os.path.exists(path) else "(no requests yet)", end="")


def cmd_env(argv):
    s = load_session()
    for key, value in session_sandbox(s).env().items():
        print(f"export {key}='{value}'")
    print("unset DISPLAY WAYLAND_DISPLAY HERDR_PANE_ID HERDR_WORKSPACE_ID NUDGE_AGENT HERDR_PLUGIN_ID HERDR_PLUGIN_EVENT_JSON HERDR_PLUGIN_CONTEXT_JSON")


def cmd_cleanup(argv):
    s = load_session()
    if pid_is(s["pid"], "fake-webhook") and pid_is(s["pid"], s["scratch"]):
        os.kill(s["pid"], signal.SIGTERM)
        print(f"stopped fake webhook pid {s['pid']}")
    if os.path.isdir(s["scratch"]):
        requests = os.path.join(s["scratch"], "requests.jsonl")
        if os.path.exists(requests):
            shutil.copy(requests, os.path.join(s["evidence"], "webhook-requests.jsonl"))
        shutil.rmtree(s["scratch"])
        print(f"removed sandbox {s['scratch']}")
    s["cleaned"] = True
    save_session(s)
    current = os.path.join(EVIDENCE_ROOT, "current")
    if os.path.exists(current) and open(current).read().strip() == s["id"]:
        os.remove(current)
    print(f"evidence kept: {s['evidence']}")


# --------------------------------------------------------------------------------------------- parity scenarios


def cmd(args, stdin=None, env=None, cwd=None, expect=None, **asserts):
    """`asserts` (all optional, see step_assertions): sends=N, toasts=[body...], has=TEXT, scope_is=(workspaces, agents)."""
    return {"do": "cmd", "argv": args, "stdin": stdin, "env": env, "cwd": cwd, "expect": expect, **asserts}


def pty(args, script, env=None, expect=None):
    return {"do": "pty", "argv": args, "script": script, "env": env, "expect": expect}


def event(status, pane="p_1", env=None, expect=0, **asserts):
    payload = json.dumps({"event": "pane.agent_status_changed", "data": {"pane_id": pane, "agent_status": status}})
    return cmd(["plugin", "event"], env={"HERDR_PLUGIN_EVENT_JSON": payload, **(env or {})}, cwd="home", expect=expect, **asserts)


def action(name, context=None, env=None, expect=0, **asserts):
    extra = dict(env or {})
    if context is not None:
        extra["HERDR_PLUGIN_CONTEXT_JSON"] = json.dumps(context)
    return cmd(["plugin", "action", name], env=extra, cwd="home", expect=expect, **asserts)


def toasts_of(rec):
    return sorted(c[4] for c in rec.get("herdr_calls", []) if c[:4] == ["notification", "show", "nudge", "--body"] and len(c) > 4)


def step_assertions(rec, op):
    """Contract assertions a scenario step opted into:
    sends=N          the desk received exactly N requests
    toasts=[...]     the herdr toasts (`notification show nudge --body X`) are exactly these bodies
    has=TEXT         TEXT appears in stdout, stderr, PTY output or an MCP response
    scope_is=(W, A)  the config file's [scope] has workspaces W and agents A (absent = [])"""
    problems = []
    if op.get("sends") is not None and len(rec.get("webhook", [])) != op["sends"]:
        problems.append(f"desk received {len(rec.get('webhook', []))} requests, expected {op['sends']}")
    if op.get("toasts") is not None and toasts_of(rec) != sorted(op["toasts"]):
        problems.append(f"toasts {toasts_of(rec)}, expected {sorted(op['toasts'])}")
    if op.get("has") is not None:
        texts = [rec.get(k) or "" for k in ("stdout", "stderr", "output")]
        texts += [json.dumps(r, ensure_ascii=False) for r in rec.get("responses_by_id", {}).values()]
        if not any(op["has"] in t for t in texts):
            problems.append(f"{op['has']!r} not in the output")
    if op.get("scope_is") is not None:
        want = {"workspaces": list(op["scope_is"][0]), "agents": list(op["scope_is"][1])}
        cfg = (rec.get("files") or {}).get("config")
        if tomllib is None:
            return problems + ["harness: scope_is needs python >= 3.11 (tomllib)"]
        try:
            got_scope = tomllib.loads(cfg["text"]).get("scope", {}) if cfg else "no config file"
        except tomllib.TOMLDecodeError as e:
            got_scope = f"unparseable config: {e}"
        got = {k: got_scope.get(k, []) for k in want} if isinstance(got_scope, dict) else got_scope
        if got != want:
            problems.append(f"config [scope] is {got}, expected {want}")
    return problems


URL = "http://127.0.0.1:{PORT}/hook"
SIGNED_URL = "http://127.0.0.1:{PORT}/signed"


def config(default="desk", extra=""):
    """Standard desks (see desks_config); `extra` TOML (an [auto] / [scope] table) is appended after a blank line."""
    return {"do": "config", "default": default, "extra": extra}


def scope(workspaces=None, agents=None):
    """A [scope] table for config(extra=...); None leaves the key out."""
    lines = ["[scope]"]
    for key, names in (("workspaces", workspaces), ("agents", agents)):
        if names is not None:
            lines.append(f"{key} = {json.dumps(names)}")
    return "\n".join(lines) + "\n"


def auto(**settings):
    """An [auto] table for config(extra=...)."""
    return "[auto]\n" + "".join(f"{k} = {json.dumps(v)}\n" for k, v in settings.items())


def raw_config(text):
    return {"do": "raw_config", "text": text}


def state(obj):
    return {"do": "state", "state": obj}


def herdr(fix):
    return {"do": "herdr", "fixture": fix}


def clip(text):
    return {"do": "clip", "text": text}


def git(name, branch, origin=None):
    return {"do": "git", "name": name, "branch": branch, "origin": origin}


def link(target=None, regular=False):
    return {"do": "link", "target": target, "regular": regular}


def write(rel, text):
    return {"do": "write", "path": rel, "text": text}


def mcp(calls, env=None, **asserts):
    return {"do": "mcp", "messages": mcp_messages(calls), "env": env, **asserts}


