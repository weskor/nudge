def cmd_cleanup(argv):
    s = load_session()
    if pid_is(s["pid"], "fake-webhook") and pid_is(s["pid"], s["scratch"]):
        os.kill(s["pid"], signal.SIGTERM)
        print(f"stopped fake webhook pid {s['pid']}")
    if os.path.isdir(s["scratch"]):
        requests = os.path.join(s["scratch"], "requests.jsonl")
        if os.path.exists(requests):
            shutil.copy(requests, os.path.join(s["evidence"], "webhook-requests.jsonl"))
        shutil.rmtree(s["scratch"])
        print(f"removed sandbox {s['scratch']}")
    s["cleaned"] = True
    save_session(s)
    current = os.path.join(EVIDENCE_ROOT, "current")
    if os.path.exists(current) and open(current).read().strip() == s["id"]:
        os.remove(current)
    print(f"evidence kept: {s['evidence']}")


# --------------------------------------------------------------------------------------------- parity scenarios


def cmd(args, stdin=None, env=None, cwd=None, expect=None, **asserts):
    """`asserts` (all optional, see step_assertions): sends=N, toasts=[body...], has=TEXT, scope_is=(workspaces, agents)."""
    return {"do": "cmd", "argv": args, "stdin": stdin, "env": env, "cwd": cwd, "expect": expect, **asserts}


def pty(args, script, env=None, expect=None, **asserts):
    """`script` steps: ["expect"|"screen", RE], ["send", TEXT], ["clip", TEXT] (see Sandbox.run_pty); asserts as cmd."""
    return {"do": "pty", "argv": args, "script": script, "env": env, "expect": expect, **asserts}


def event(status, pane="p_1", env=None, expect=0, **asserts):
    payload = json.dumps({"event": "pane.agent_status_changed", "data": {"pane_id": pane, "agent_status": status}})
    return cmd(["plugin", "event"], env={"HERDR_PLUGIN_EVENT_JSON": payload, **(env or {})}, cwd="home", expect=expect, **asserts)


def action(name, context=None, env=None, expect=0, **asserts):
    extra = dict(env or {})
    if context is not None:
        extra["HERDR_PLUGIN_CONTEXT_JSON"] = json.dumps(context)
    return cmd(["plugin", "action", name], env=extra, cwd="home", expect=expect, **asserts)


def toasts_of(rec):
    return sorted(c[4] for c in rec.get("herdr_calls", []) if c[:4] == ["notification", "show", "nudge", "--body"] and len(c) > 4)


def shown_texts(rec):
    """Everything nudge showed: stdout, stderr, PTY output and screens, MCP responses."""
    texts = [rec.get(k) or "" for k in ("stdout", "stderr", "output")]
    texts += ["\n".join(s["lines"]) for s in rec.get("screens", [])]
    return texts + [json.dumps(r, ensure_ascii=False) for r in rec.get("responses_by_id", {}).values()]


def step_assertions(rec, op, config_before=None):
    """Contract assertions a scenario step opted into:
    sends=N              the webhook received exactly N requests
    toasts=[...]         the herdr toasts (`notification show nudge --body X`) are exactly these bodies
    has=TEXT|[TEXT...]   each TEXT appears in stdout, stderr, PTY output/screens or an MCP response
    lacks=[TEXT...]      none of these appear there
    scope_is=(W, A)      the config file's [scope] has workspaces W and agents A (absent = [])
    config_keys={K: V}   the config's top-level key K parses to V (None = absent), e.g. {"auto": {...}, "scope": None}
    state_auto=BOOL      state.json `auto` after the step
    state_keys={K: V}    state.json's top-level key K is V after the step (None = absent), e.g. {"away": None}
    config_mode=MODE     the config file's permission bits, e.g. "600"
    herdr_has=[ARGV...]  each of these herdr calls was made (exact argv)
    config_unchanged=1   the config text is byte-for-byte what it was before the step"""
    problems = []
    cfg = (rec.get("files") or {}).get("config")
    if op.get("sends") is not None and len(rec.get("webhook", [])) != op["sends"]:
        problems.append(f"webhook received {len(rec.get('webhook', []))} requests, expected {op['sends']}")
    if op.get("toasts") is not None and toasts_of(rec) != sorted(op["toasts"]):
        problems.append(f"toasts {toasts_of(rec)}, expected {sorted(op['toasts'])}")
    for text in [op["has"]] if isinstance(op.get("has"), str) else op.get("has") or []:
        if not any(text in t for t in shown_texts(rec)):
            problems.append(f"{text!r} not in the output")
    for text in op.get("lacks") or []:
        if any(text in t for t in shown_texts(rec)):
            problems.append(f"{text!r} shown, expected absent")
    if op.get("state_auto") is not None:
        got = ((rec.get("files") or {}).get("state") or {}).get("json", {}).get("auto")
        if got != op["state_auto"]:
            problems.append(f"state.json auto is {got}, expected {op['state_auto']}")
    for key, want in (op.get("state_keys") or {}).items():
        saved = ((rec.get("files") or {}).get("state") or {}).get("json")
        present = isinstance(saved, dict) and key in saved
        if (want is None and present) or (want is not None and (not present or saved[key] != want)):
            got = repr(saved[key]) if present else "absent"
            problems.append(f"state.json {key} is {got}, expected {'absent' if want is None else repr(want)}")
    if op.get("config_unchanged") and (cfg or {}).get("text") != config_before:
        problems.append("config text changed, expected unchanged")
    if op.get("config_mode") is not None and (cfg or {}).get("mode") != op["config_mode"]:
        problems.append(f"config mode {(cfg or {}).get('mode')}, expected {op['config_mode']}")
    for argv in op.get("herdr_has") or []:
        if argv not in rec.get("herdr_calls", []):
            problems.append(f"no herdr call {argv}")
    if op.get("scope_is") is None and op.get("config_keys") is None:
        return problems
    if tomllib is None:
        return problems + ["harness: scope_is/config_keys need python >= 3.11 (tomllib)"]
    try:
        parsed = tomllib.loads(cfg["text"]) if cfg else "no config file"
    except tomllib.TOMLDecodeError as e:
        parsed = f"unparseable config: {e}"
    if op.get("scope_is") is not None:
        want = {"workspaces": list(op["scope_is"][0]), "agents": list(op["scope_is"][1])}
        got_scope = parsed.get("scope", {}) if isinstance(parsed, dict) else parsed
        got = {k: got_scope.get(k, []) for k in want} if isinstance(got_scope, dict) else got_scope
        if got != want:
            problems.append(f"config [scope] is {got}, expected {want}")
    for key, want in (op.get("config_keys") or {}).items():
        got = parsed.get(key) if isinstance(parsed, dict) else parsed
        if got != want:
            problems.append(f"config {key} is {got!r}, expected {want!r}")
    return problems


URL = "http://127.0.0.1:{PORT}/hook"
SIGNED_URL = "http://127.0.0.1:{PORT}/signed"


def config(default="main", extra=""):
    """Standard webhooks (see webhooks_config); `extra` TOML (an [auto] / [scope] table) is appended after a blank line."""
    return {"do": "config", "default": default, "extra": extra}


def scope(workspaces=None, agents=None):
    """A [scope] table for config(extra=...); None leaves the key out."""
    lines = ["[scope]"]
    for key, names in (("workspaces", workspaces), ("agents", agents)):
        if names is not None:
            lines.append(f"{key} = {json.dumps(names)}")
    return "\n".join(lines) + "\n"


def auto(**settings):
    """An [auto] table for config(extra=...)."""
    return "[auto]\n" + "".join(f"{k} = {json.dumps(v)}\n" for k, v in settings.items())


def raw_config(text):
    return {"do": "raw_config", "text": text}


def state(obj):
    return {"do": "state", "state": obj}


def herdr(fix):
    return {"do": "herdr", "fixture": fix}


def clip(text):
    return {"do": "clip", "text": text}


def git(name, branch, origin=None):
    return {"do": "git", "name": name, "branch": branch, "origin": origin}


def link(target=None, regular=False):
    return {"do": "link", "target": target, "regular": regular}


def write(rel, text):
    return {"do": "write", "path": rel, "text": text}


def mcp(calls, env=None, **asserts):
    return {"do": "mcp", "messages": mcp_messages(calls), "env": env, **asserts}


