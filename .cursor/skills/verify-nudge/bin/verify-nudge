        pty(["settings"], [
            on_screen("Shortest turn sent      90 seconds", "Cooldown per pane       45 seconds", "Terminal lines sent     200"),
            keys("jj "), on_screen(cursor="[ ] Toast when one is sent"),
            keys("jl"), on_screen(cursor="◂ 2 minutes ▸"),  # 90 s snaps up to the 120 s preset
            keys("jh"), on_screen(cursor="◂ 0 seconds ▸"),  # 45 s snaps down to 0
            keys("j "), on_screen(cursor="Terminal lines sent   ◂ 10 ▸"),  # Space cycles up and wraps 200 -> 10
            keys("s")], expect=0, has=saved, state_auto=False,
            config_keys={"auto": {"toast": False, "cooldown_seconds": 0, "tail_lines": 10}, "scope": None, "default_webhook": "main"}))
    add("settings-only-these-empty-then-discard", config(), set_herdr, state({"auto": True}),
        pty(["settings"], [
            on_screen(cursor="[x] Auto-notify"),
            keys("jjjjjjj "), on_screen("( ) Every agent", cursor="(•) Only these:"),
            keys("s"), on_screen(SETTINGS_NOTHING_TICKED),
            keys("q"), on_screen(SETTINGS_UNSAVED, cursor="(•) Only these:"),
            keys("j"), on_screen(SETTINGS_UNSAVED, cursor="[ ] api-work"),  # another key disarms the discard...
            keys(ESC), on_screen(SETTINGS_UNSAVED, cursor="[ ] api-work"),  # ...so Esc only warns again
            keys(CTRL_C)], expect=0, has=unchanged, sends=0, toasts=[], state_auto=True, config_unchanged=True))
    add("settings-test-ping", config(), set_herdr,
        pty(["settings"], [
            on_screen(SETTINGS_HELP),
            keys("j" * 20), on_screen(cursor="( ) signed    127.0.0.1  signed"),
            keys("t"), drawn('Testing "signed"…'), on_screen('✓ "signed" received a test ping (HTTP 200)'),
            keys("kkkk"), on_screen(cursor="( ) badauth"),
            # The status wraps inside the box (up to 4 rows), so the fix hint stays whole on the next row.
            keys("t"), on_screen('✗ webhook "badauth" returned HTTP 401', "copy the Authorization header again with nudge setup"),
            keys("j"), on_screen(cursor="( ) nohook"),
            keys("t"), on_screen('✗ webhook "nohook" returned HTTP 404: no such hook;', "Webhook URL again with nudge setup"),
            keys("k" * 17 + "t"), on_screen("Move to a webhook to test it.", cursor="[ ] Auto-notify"),
            keys("q")], expect=0, sends=3, has=unchanged, config_unchanged=True))
    add("settings-pane", config(), set_herdr,
        pty(["settings", "--pane"], [
            on_screen(cursor="[ ] Auto-notify"), keys(" "), on_screen(cursor="[x] Auto-notify"), keys("s")],
            expect=0, has=saved, toasts=["Settings saved"], state_auto=True,
            herdr_has=[["notification", "show", "nudge", "--body", "Settings saved"]]),
        pty(["settings", "--pane"], [on_screen(cursor="[x] Auto-notify"), keys("q")],
            expect=0, has=unchanged, toasts=[], config_unchanged=True))
    add("settings-away", config(), set_herdr, state({"auto": True}),
        pty(["settings"], [
            on_screen("[x] Auto-notify", "[ ] " + away_row, "[x] Toast when one is sent", cursor="[x] Auto-notify"),
            keys("j"), on_screen(cursor="[ ] " + away_row),
            keys(" "), on_screen(cursor="[x] " + away_row),
            keys("s")], expect=0, has=saved, sends=0, toasts=[], state_auto=True, state_keys={"away": True}),
        pty(["settings"], [
            on_screen("[x] Auto-notify", "[x] " + away_row, cursor="[x] Auto-notify"),
            keys("q")], expect=0, has=unchanged, config_unchanged=True, state_auto=True, state_keys={"away": True}),
        pty(["settings"], [
            on_screen("[x] " + away_row), keys("j\\r"), on_screen(cursor="[ ] " + away_row),  # Enter flips it too
            keys("s")], expect=0, has=saved, state_auto=True, state_keys={"away": None}),
        pty(["settings"], [on_screen("[x] Auto-notify", "[ ] " + away_row), keys("q")], expect=0, has=unchanged))
    add("settings-away-from-action", config(), set_herdr, action("away-on", toasts=[away_on]),
        pty(["settings", "--pane"], [
            on_screen("[ ] Auto-notify", "[x] " + away_row, cursor="[ ] Auto-notify"),
            keys(" "), on_screen(cursor="[x] Auto-notify"), keys("s")],
            expect=0, has=saved, toasts=["Settings saved"], state_auto=True, state_keys={"away": True}))
    add("settings-scope-not-open",
        config(extra=scope(workspaces=["api-work", "old-ws", "wE"], agents=["claude-1", "gone-agent"])), set_herdr,
        pty(["settings"], [
            on_screen("( ) Every agent", "(•) Only these:", "[x] api-work  1 agent", "[x] web-work  1 agent",
                      "[ ] wF        1 agent", "[x] old-ws    (not open)", "[x] claude-1    api-work · api",
                      "[ ] reviewer    web-work · web", "[ ] wF:p4       wF · misc", "[x] gone-agent  (not open)"),
            keys("j" * 13 + " "), on_screen(cursor="[x] reviewer"),
            keys("s")], expect=0, has=saved,
            scope_is=(["api-work", "web-work", "old-ws"], ["claude-1", "reviewer", "gone-agent"])),
        pty(["settings"], [
            on_screen("[x] old-ws    (not open)", "[x] reviewer", "[x] gone-agent  (not open)"),
            keys("j" * 11 + " "), on_screen(cursor="[ ] old-ws    (not open)"),
            keys("s")], expect=0, has=saved, scope_is=(["api-work", "web-work"], ["claude-1", "reviewer", "gone-agent"])))
    add("settings-every-agent", config(extra=scope(workspaces=["api-work"])), set_herdr,
        pty(["settings"], [
            on_screen("( ) Every agent", "(•) Only these:", "[x] api-work"),
            keys("jjjjjj "), on_screen("( ) Only these…", cursor="(•) Every agent"),
            keys("s")], expect=0, has=saved, config_keys={"scope": None}))
    add("action-settings-pane", herdr(PRESETS["running"]),
        action("settings", sends=0, toasts=[],
               herdr_has=[["plugin", "pane", "open", "--plugin", PLUGIN_ID, "--entrypoint", "settings", "--focus"]]))
    add("action-settings-pane-fails", action("settings", expect=1, has="could not open the settings pane"))
    return S


def run_scenario(index, name, ops, scratch, binary, root, port, offline_port):
    run = os.path.join(scratch, "s", f"{index:03d}")
    sb = Sandbox(run, binary, port, offline_port, os.path.join(scratch, "requests.jsonl")).create()
    sb.mark()
    t0 = now_ms()
    subst = lambda v: v.replace("{PORT}", str(port)).replace("{OFFLINE_PORT}", str(offline_port)).replace("{NUDGE_ROOT}", root).replace("{RUN}", run) if isinstance(v, str) else v
    steps, setup_log, checks = [], [], []
    for op in ops:
        do = op["do"]
        if do == "config":
            sb.write_config(webhooks_config(port, offline_port, op.get("default", "main"), "\n" + op["extra"] if op.get("extra") else ""))
            setup_log.append(f"config: standard webhooks, default {op.get('default', 'main')}" + (" + " + json.dumps(op["extra"]) if op.get("extra") else ""))
        elif do == "raw_config":
            sb.write_config(subst(op["text"]))
            setup_log.append("config: raw text " + json.dumps(op["text"][:40]))
        elif do == "state":
            sb.write_state(op["state"])
            setup_log.append("state: " + json.dumps(op["state"], sort_keys=True))
        elif do == "edit_state":
            sb.edit_state(op["pane"], op["key"], op["ago"])
            setup_log.append(f"state: panes.{op['pane']}.{op['key']} = now-{op['ago']}ms")
        elif do == "herdr":
            sb.write_herdr(op["fixture"])
            setup_log.append("herdr fixture: " + ("none (not installed)" if op["fixture"] is None else f"{len(op['fixture']['rules'])} rules"))
        elif do == "clip":
            sb.clip(subst(op["text"]))
            setup_log.append("clipboard set")
        elif do == "git":
            sb.git_repo(op["name"], op["branch"], op["origin"])
            setup_log.append(f"git repo {op['name']} on {op['branch']} origin {op['origin']}")
        elif do == "link":
            os.makedirs(os.path.dirname(sb.link), exist_ok=True)
            if op["regular"]:
                open(sb.link, "w").write("#!/bin/sh\n")
                setup_log.append("~/.local/bin/nudge: regular file")
            else:
                os.symlink(subst(op["target"]), sb.link)
                setup_log.append(f"~/.local/bin/nudge -> {op['target']}")
        elif do == "write":
            path = os.path.join(run, op["path"])
            os.makedirs(os.path.dirname(path), exist_ok=True)
            open(path, "w").write(op["text"])
            setup_log.append(f"file {op['path']}")
        elif do in ("cmd", "pty", "mcp"):
            before = sb.files()["config"]
            if do == "cmd":
                env = {k: subst(v) for k, v in (op["env"] or {}).items()}
                rec = sb.run_cmd([subst(a) for a in op["argv"]], stdin=subst(op["stdin"]), env=env, cwd=op["cwd"])
            elif do == "pty":
                script = [[k, subst(v)] for k, v in op["script"]]
                rec = sb.run_pty([subst(a) for a in op["argv"]], script, env=op["env"])
            else:
                rec = sb.run_mcp(op["messages"], env=op["env"])
            steps.append((rec, op, before and before["text"]))
    t1 = now_ms()
    norm = Normalizer(sb, root, t0)
    out_steps = []
    for i, (rec, op, config_before) in enumerate(steps, start=1):
        leaks = secret_leaks(rec)
        if leaks:
            checks.append(f"step {i}: secret printed {sorted(set(leaks))}")
        if op.get("expect") is not None and rec["exit"] != op["expect"]:
            checks.append(f"step {i}: exit {rec['exit']}, expected {op['expect']}")
        if rec.get("expect_failures"):
            checks.append(f"step {i}: {rec['expect_failures']}")
        if rec.get("missing_responses"):
            checks.append(f"step {i}: no response for ids {rec['missing_responses']}")
        checks += [f"step {i}: {problem}" for problem in contract_checks(rec) + step_assertions(rec, op, config_before)]
        out_steps.append(norm.record(rec, t1))
    return {"name": name, "setup": [norm.text(s) for s in setup_log], "steps": out_steps, "check_failures": checks}


def cmd_parity(argv):
    if not argv or argv[0].startswith("-"):
        die("usage: verify-nudge parity OUT.json [--only SUBSTRING]...", 2)
    out_path = os.path.abspath(argv[0])
    only = [argv[i + 1] for i, a in enumerate(argv) if a == "--only"]
    binary = nudge_bin()
    root = nudge_root(binary)
    os.umask(0o022)
    scratch = os.path.realpath(tempfile.mkdtemp(prefix="verify-nudge-parity-"))
    pid = None
    try:
        pid, port = start_webhook(scratch, "parity")
        offline_port = free_port()
        selected = [(n, ops) for n, ops in scenarios() if not only or any(o in n for o in only)]
        results = []
        for index, (name, ops) in enumerate(selected, start=1):
            sys.stderr.write(f"[{index}/{len(selected)}] {name}\n")
            try:
                results.append(run_scenario(index, name, ops, scratch, binary, root, port, offline_port))
            except Exception as e:  # keep going: one broken scenario must not hide the rest of the diff
                results.append({"name": name, "setup": [], "steps": [], "check_failures": [f"harness error: {type(e).__name__}: {e}"]})
        failures = [(r["name"], c) for r in results for c in r["check_failures"]]
        transcript = {
            "harness": "verify-nudge parity v4",
            "normalized": ["<RUN> = per-scenario sandbox dir", "<NUDGE_ROOT> = dirname(dirname(realpath(NUDGE_BIN)))",
                           "<PORT>/<OFFLINE_PORT> = fake webhook / closed port", "state.json epoch ms: <now>, <now-Nms> (seeded), <epoch-ms>",
                           "herdr_calls sorted (some are concurrent)", "JSON stdout and MCP responses compared as sorted-key JSON; MCP responses keyed by id",
                           "doctor 'Recent:' line ages -> <ago>", "lowercase UUID v4 -> <uuid>; YYYY-MM-DDTHH:MM:SSZ -> <sent_at>",
                           "webhook x-nudge-timestamp within 60 s -> <ts>; well-formed x-nudge-signature -> sha256=<hmac> "
                           "(validity is the request's \"signature\" verdict); received_unix dropped",
                           "PTY steps with `screen` expectations: rendered screens (`screens`, highlighted rows '> ') and the "
                           "normal-screen text left at exit (`output`) instead of raw bytes"],
            "scenario_count": len(results),
            "scenarios": results,
        }
        os.makedirs(os.path.dirname(out_path), exist_ok=True)
        with open(out_path, "w") as f:
            json.dump(transcript, f, indent=2, ensure_ascii=False, sort_keys=True)
            f.write("\n")
        print(f"wrote {out_path}: {len(results)} scenarios, {len(failures)} check failures")
        for name, c in failures:
            print(f"  CHECK {name}: {c}")
        if failures:
            sys.exit(1)
    finally:
        if pid and pid_is(pid, "fake-webhook"):
            os.kill(pid, signal.SIGTERM)
        shutil.rmtree(scratch, ignore_errors=True)


COMMANDS = {
    "launch": cmd_launch, "doctor": cmd_doctor, "run": cmd_run, "pty": cmd_pty, "mcp": cmd_mcp,
    "seed-config": cmd_seed_config, "seed-state": cmd_seed_state, "herdr": cmd_herdr, "clip": cmd_clip,
    "git-repo": cmd_git_repo, "link": cmd_link,
    "files": cmd_files, "requests": cmd_requests, "env": cmd_env, "cleanup": cmd_cleanup, "parity": cmd_parity,
}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        sys.stdout.write(__doc__)
        sys.exit(0 if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help", "help") else 2)
    COMMANDS[sys.argv[1]](sys.argv[2:])
