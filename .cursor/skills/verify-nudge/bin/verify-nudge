    + "aws AKIA0123456789ABCDEF\n"
    + "jwt eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.SflKxwRJSMeKKF2QT4fwpM\n"
    + "commit 0123456789abcdef0123456789abcdef01234567 kept\n"
    + "random Zx9Qw8Er7Ty6Ui5Op4As3Df2Gh1Jk0LmNbVc\n"
    + "-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA\n-----END RSA PRIVATE KEY-----\n"
