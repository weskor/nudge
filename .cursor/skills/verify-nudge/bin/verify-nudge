    return S


def run_scenario(index, name, ops, scratch, binary, root, port, offline_port):
    run = os.path.join(scratch, "s", f"{index:03d}")
    sb = Sandbox(run, binary, port, offline_port, os.path.join(scratch, "requests.jsonl")).create()
    sb.mark()
    t0 = now_ms()
    subst = lambda v: v.replace("{PORT}", str(port)).replace("{OFFLINE_PORT}", str(offline_port)).replace("{NUDGE_ROOT}", root).replace("{RUN}", run) if isinstance(v, str) else v
    steps, setup_log, checks = [], [], []
    for op in ops:
        do = op["do"]
        if do == "config":
            sb.write_config(desks_config(port, offline_port, op.get("default", "desk"), "\n" + op["extra"] if op.get("extra") else ""))
            setup_log.append(f"config: standard desks, default {op.get('default', 'desk')}" + (" + " + json.dumps(op["extra"]) if op.get("extra") else ""))
        elif do == "raw_config":
            sb.write_config(subst(op["text"]))
            setup_log.append("config: raw text " + json.dumps(op["text"][:40]))
        elif do == "state":
            sb.write_state(op["state"])
            setup_log.append("state: " + json.dumps(op["state"], sort_keys=True))
        elif do == "edit_state":
            sb.edit_state(op["pane"], op["key"], op["ago"])
            setup_log.append(f"state: panes.{op['pane']}.{op['key']} = now-{op['ago']}ms")
        elif do == "herdr":
            sb.write_herdr(op["fixture"])
            setup_log.append("herdr fixture: " + ("none (not installed)" if op["fixture"] is None else f"{len(op['fixture']['rules'])} rules"))
        elif do == "clip":
            sb.clip(subst(op["text"]))
            setup_log.append("clipboard set")
        elif do == "git":
            sb.git_repo(op["name"], op["branch"], op["origin"])
            setup_log.append(f"git repo {op['name']} on {op['branch']} origin {op['origin']}")
        elif do == "link":
            os.makedirs(os.path.dirname(sb.link), exist_ok=True)
            if op["regular"]:
                open(sb.link, "w").write("#!/bin/sh\n")
                setup_log.append("~/.local/bin/nudge: regular file")
            else:
                os.symlink(subst(op["target"]), sb.link)
                setup_log.append(f"~/.local/bin/nudge -> {op['target']}")
        elif do == "write":
            path = os.path.join(run, op["path"])
            os.makedirs(os.path.dirname(path), exist_ok=True)
            open(path, "w").write(op["text"])
            setup_log.append(f"file {op['path']}")
        elif do == "cmd":
            env = {k: subst(v) for k, v in (op["env"] or {}).items()}
            rec = sb.run_cmd([subst(a) for a in op["argv"]], stdin=subst(op["stdin"]), env=env, cwd=op["cwd"])
            steps.append((rec, op))
        elif do == "pty":
            script = [[k, subst(v)] for k, v in op["script"]]
            rec = sb.run_pty([subst(a) for a in op["argv"]], script, env=op["env"])
            steps.append((rec, op))
        elif do == "mcp":
            rec = sb.run_mcp(op["messages"], env=op["env"])
            steps.append((rec, op))
    t1 = now_ms()
    norm = Normalizer(sb, root, t0)
    out_steps = []
    for i, (rec, op) in enumerate(steps, start=1):
        leaks = secret_leaks(rec)
        if leaks:
            checks.append(f"step {i}: secret printed {sorted(set(leaks))}")
        if op.get("expect") is not None and rec["exit"] != op["expect"]:
            checks.append(f"step {i}: exit {rec['exit']}, expected {op['expect']}")
        if rec.get("expect_failures"):
            checks.append(f"step {i}: {rec['expect_failures']}")
        if rec.get("missing_responses"):
            checks.append(f"step {i}: no response for ids {rec['missing_responses']}")
        checks += [f"step {i}: {problem}" for problem in contract_checks(rec) + step_assertions(rec, op)]
        out_steps.append(norm.record(rec, t1))
    return {"name": name, "setup": [norm.text(s) for s in setup_log], "steps": out_steps, "check_failures": checks}


def cmd_parity(argv):
    if not argv or argv[0].startswith("-"):
        die("usage: verify-nudge parity OUT.json [--only SUBSTRING]...", 2)
    out_path = os.path.abspath(argv[0])
    only = [argv[i + 1] for i, a in enumerate(argv) if a == "--only"]
    binary = nudge_bin()
    root = nudge_root(binary)
    os.umask(0o022)
    scratch = os.path.realpath(tempfile.mkdtemp(prefix="verify-nudge-parity-"))
    pid = None
    try:
        pid, port = start_webhook(scratch, "parity")
        offline_port = free_port()
        selected = [(n, ops) for n, ops in scenarios() if not only or any(o in n for o in only)]
        results = []
        for index, (name, ops) in enumerate(selected, start=1):
            sys.stderr.write(f"[{index}/{len(selected)}] {name}\n")
            try:
                results.append(run_scenario(index, name, ops, scratch, binary, root, port, offline_port))
            except Exception as e:  # keep going: one broken scenario must not hide the rest of the diff
                results.append({"name": name, "setup": [], "steps": [], "check_failures": [f"harness error: {type(e).__name__}: {e}"]})
        failures = [(r["name"], c) for r in results for c in r["check_failures"]]
        transcript = {
            "harness": "verify-nudge parity v3",
            "normalized": ["<RUN> = per-scenario sandbox dir", "<NUDGE_ROOT> = dirname(dirname(realpath(NUDGE_BIN)))",
                           "<PORT>/<OFFLINE_PORT> = fake webhook / closed port", "state.json epoch ms: <now>, <now-Nms> (seeded), <epoch-ms>",
                           "herdr_calls sorted (some are concurrent)", "JSON stdout and MCP responses compared as sorted-key JSON; MCP responses keyed by id",
                           "doctor 'Recent:' line ages -> <ago>", "lowercase UUID v4 -> <uuid>; YYYY-MM-DDTHH:MM:SSZ -> <sent_at>",
                           "webhook x-nudge-timestamp within 60 s -> <ts>; well-formed x-nudge-signature -> sha256=<hmac> "
                           "(validity is the request's \"signature\" verdict); received_unix dropped"],
            "scenario_count": len(results),
            "scenarios": results,
        }
        os.makedirs(os.path.dirname(out_path), exist_ok=True)
        with open(out_path, "w") as f:
            json.dump(transcript, f, indent=2, ensure_ascii=False, sort_keys=True)
            f.write("\n")
        print(f"wrote {out_path}: {len(results)} scenarios, {len(failures)} check failures")
        for name, c in failures:
            print(f"  CHECK {name}: {c}")
        if failures:
            sys.exit(1)
    finally:
        if pid and pid_is(pid, "fake-webhook"):
            os.kill(pid, signal.SIGTERM)
        shutil.rmtree(scratch, ignore_errors=True)


COMMANDS = {
    "launch": cmd_launch, "doctor": cmd_doctor, "run": cmd_run, "pty": cmd_pty, "mcp": cmd_mcp,
    "seed-config": cmd_seed_config, "seed-state": cmd_seed_state, "herdr": cmd_herdr, "clip": cmd_clip,
    "git-repo": cmd_git_repo, "link": cmd_link,
    "files": cmd_files, "requests": cmd_requests, "env": cmd_env, "cleanup": cmd_cleanup, "parity": cmd_parity,
}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
        sys.stdout.write(__doc__)
        sys.exit(0 if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help", "help") else 2)
    COMMANDS[sys.argv[1]](sys.argv[2:])
