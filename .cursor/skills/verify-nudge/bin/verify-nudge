def on_screen(*parts, cursor=None):
    """A `screen` step: the literal `parts` appear on the rendered screen in this order; `cursor` is literal text on
    the highlighted (reverse-video) row."""
    pattern = r"(?s)\A(?=.*" + ".*".join(re.escape(p) for p in parts) + ")"
    if cursor is not None:
        pattern += rf"(?=.*^> [^\n]*{re.escape(cursor)})"
    return ["screen", pattern]


ESCAPE_SEQUENCE = r"\x1b\[[0-9;?]*[ -/]*[@-~]"


def drawn(text):
    """An `expect` step for `text` drawn by ratatui onto blank cells: style codes may sit between its characters,
    and a space may be a cursor jump over a cell that was already blank."""
    return ["expect", f"(?:{ESCAPE_SEQUENCE})*".join(f"(?: |(?:{ESCAPE_SEQUENCE})+)" if ch == " " else re.escape(ch) for ch in text)]


def keys(text):
    return ["send", text]


SETTINGS_HELP = "↑↓ move  space pick  ←→ change  t test  s save  q quit"
SETTINGS_UNSAVED = "Unsaved changes: press q again to discard them, or s to save."
SETTINGS_NOTHING_TICKED = "Tick at least one workspace or agent, or choose Every agent."
SETUP_HELP = "↑↓ move  enter paste/next  space tick  ctrl-s test & save  esc quit"
SETUP_HELP_NO_TEST = "↑↓ move  enter paste/next  space tick  ctrl-s save  esc quit"
UP, DOWN, LEFT, RIGHT, ESC, CTRL_C = "\\e[A", "\\e[B", "\\e[D", "\\e[C", "\\e", "\\x03"
CTRL_S, CTRL_U = "\\x13", "\\x15"



def scenarios():
    S = []
    add = lambda name, *ops: S.append((name, list(ops)))

    # ---- top-level CLI
    add("cli-help", cmd(["--help"], expect=0), cmd(["-h"], expect=0), cmd(["help"], expect=0))
    add("cli-no-args", cmd([], expect=2))
    add("cli-version", cmd(["version"], expect=0), cmd(["--version"], expect=0), cmd(["-v"], expect=0))
    add("cli-unknown-command", cmd(["frobnicate"], expect=2))
    add("cli-unknown-option", config(), cmd(["list", "--bogus"], expect=2))
    add("cli-extra-args", config(), cmd(["list", "extra"], expect=2), cmd(["test", "extra"], expect=2),
        cmd(["doctor", "extra"], expect=2), cmd(["setup", "extra"], expect=2), cmd(["mcp", "extra"], expect=2))
    add("cli-notify-bad-status", config(), cmd(["notify", "--status", "urgent", "hi"], expect=2))
    add("cli-notify-no-message", config(), cmd(["notify"], expect=2), cmd(["notify", "--status", "blocked"], expect=2))

    # ---- list
    add("list", config(), cmd(["list"], expect=0), cmd(["list", "--json"], expect=0))
