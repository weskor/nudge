#!/bin/sh
# Run nudge: the binary from the herdr build step (dist/nudge), else a local `cargo build --release`
# (target/release/nudge) for linked checkouts. NUDGE_ROOT tells nudge where its plugin files live.
self=$(readlink -f "$0" 2>/dev/null || echo "$0")
root=$(cd "$(dirname "$self")/.." && pwd)
export NUDGE_ROOT="$root"
for binary in "$root/dist/nudge" "$root/target/release/nudge"; do
  if [ -x "$binary" ]; then
    exec "$binary" "$@"
  fi
done
echo "nudge: no binary in $root/dist or $root/target/release." >&2
echo "Reinstall the plugin (herdr plugin install weskor/nudge), or build it: cargo build --release" >&2
exit 1
